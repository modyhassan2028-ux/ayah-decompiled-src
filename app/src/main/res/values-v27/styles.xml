<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/quran_bars</item>
        <item name="android:navigationBarColor">@color/quran_secondary_background</item>
        <item name="android:windowLightStatusBar">@bool/is_light_mode</item>
        <item name="android:windowLightNavigationBar">@bool/is_light_mode</item>
        <item name="colorControlActivated">@color/light_cursor</item>
        <item name="colorPrimary">@color/tint</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSurface">@color/background</item>
    </style>
    <style name="AppTheme.TranslucentNav" parent="@style/AppTheme">
        <item name="android:colorControlActivated">@color/light_cursor</item>
        <item name="android:colorPrimary">@android:color/white</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
